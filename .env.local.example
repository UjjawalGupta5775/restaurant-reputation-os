# Restaurant Reputation OS — environment template
# Copy this file to .env.local and fill in the values from your Supabase project.

# Supabase — Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — anon public key (Settings → API → Project API Keys → anon/public)
# Safe to expose to the browser; RLS enforces all access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (Settings → API → Project API Keys → service_role)
# NEVER expose to the browser. Only used by server-only modules
# (lib/supabase/admin.ts and the /api/owners invite flow).
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL — used to build invite redirect links.
# Local: http://localhost:3000  |  Prod: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection (LOCAL DEV ONLY — used by scripts/*.mjs verification utilities).
# Do not set this in Vercel; production code talks to Supabase via the HTTP API.
# Format: postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
POSTGRES_URL=

# Salt used when hashing client IPs for the funnel rate limiter.
# Optional — a non-secret default is used if unset, but setting this in prod
# makes the funnel_rate_limits table harder to enumerate if it ever leaks.
RATE_LIMIT_SALT=

# Resend API key for the weekly digest email (https://resend.com).
# Optional — if unset, the digest cron logs each send as "skipped" and the
# job no-ops cleanly. Set this in prod once a domain is verified in Resend.
RESEND_API_KEY=

# Verified sender address used in the digest. Format: "Name <addr@domain>".
# Default falls back to Resend's onboarding sender, which only delivers to
# the account owner — fine for testing, replace before launch.
DIGEST_FROM_EMAIL=

# Shared secret protecting the /api/cron/* endpoints. Vercel sends this in
# the Authorization header on every cron invocation. Manual triggers can
# pass it via ?secret=<value>.
CRON_SECRET=
