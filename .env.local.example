# Reputation OS — environment template
# Copy this file to .env.local and fill in the values from your Supabase project.
#
# One-time Supabase Dashboard setup (NOT env vars — flip these in the Supabase
# project once before going to production):
#   * Authentication → Sign In/Up → "Confirm email"           → enabled
#   * Authentication → URL Configuration → Site URL            →
#       https://restaurant-reputation-os.vercel.app
#   * Authentication → URL Configuration → Additional Redirect URLs →
#       https://restaurant-reputation-os.vercel.app/auth/confirm
#       https://*.vercel.app/auth/confirm        (preview deployments)
#       http://localhost:3000/auth/confirm       (local dev)
#       https://*.ngrok-free.app/auth/confirm    (ngrok tunnels)
# When "Confirm email" is enabled, /auth/signup returns the "check your email"
# notice instead of signing the user in immediately; the link in the email
# lands on /auth/confirm which calls verifyOtp and redirects to /dashboard.

# Supabase — Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — anon public key (Settings → API → Project API Keys → anon/public)
# Safe to expose to the browser; RLS enforces all access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (Settings → API → Project API Keys → service_role)
# NEVER expose to the browser. Only used by server-only modules
# (lib/supabase/admin.ts and the /api/owners invite flow).
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL — used to build invite redirect links.
# Local: http://localhost:3000  |  Prod: https://restaurant-reputation-os.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection (LOCAL DEV ONLY — used by scripts/*.mjs verification utilities).
# Do not set this in Vercel; production code talks to Supabase via the HTTP API.
# Format: postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
POSTGRES_URL=

# Salt used when hashing client IPs for the funnel rate limiter.
# Optional — a non-secret default is used if unset, but setting this in prod
# makes the funnel_rate_limits table harder to enumerate if it ever leaks.
RATE_LIMIT_SALT=

# Resend API key for the weekly digest email (https://resend.com).
# Optional — if unset, the digest cron logs each send as "skipped" and the
# job no-ops cleanly. Set this in prod once a domain is verified in Resend.
RESEND_API_KEY=

# Verified sender address used in the digest. Format: "Name <addr@domain>".
# Default falls back to Resend's onboarding sender, which only delivers to
# the account owner — fine for testing, replace before launch.
DIGEST_FROM_EMAIL=

# Verified sender address used for billing notifications (payment failed,
# canceled, expired, etc). Optional — falls back to DIGEST_FROM_EMAIL,
# then to Resend's onboarding sender.
BILLING_FROM_EMAIL=

# Shared secret protecting the /api/cron/* endpoints. Vercel sends this in
# the Authorization header on every cron invocation. Manual triggers can
# pass it via ?secret=<value>.
CRON_SECRET=

# Public site URL — absolute base used by server actions that need to build
# externally-resolvable URLs (Lemon Squeezy checkout return_url, etc).
# Local: http://localhost:3000  |  Prod: https://restaurant-reputation-os.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lemon Squeezy — billing provider. All four are required in prod.
# API key: LS dashboard → Settings → API. Store ID: Stores → your store.
# Variant ID: Products → variant → Edit → URL slug (numeric id).
# Webhook secret: Settings → Webhooks. Rotate API key + webhook secret together.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Sentry — error + performance monitoring. All optional in dev; set in prod
# to surface exceptions. SENTRY_DSN is server-side; NEXT_PUBLIC_SENTRY_DSN
# is picked up by the browser bundle. SENTRY_ORG / SENTRY_PROJECT are used
# by the build-time source-map upload. Sample rates accept 0.0–1.0.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Demo owner credentials used ONLY by scripts/verify-*.mjs verification
# utilities. Never read by application code; never set in Vercel.
# Used by:
#   scripts/verify-billing-banner.mjs  — logs in as the demo owner to
#     assert the BillingBanner actually renders end-to-end.
#   scripts/verify-cross-tenant.mjs    — references the super-admin email
#     for log lines that compare cross-tenant visibility.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
